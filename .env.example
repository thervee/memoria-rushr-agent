# Copy this file to .env (which is gitignored) and fill in your own values there.
# Never put real keys in this example file, the README, AGENT.md, the logs, or git.

# Memoria (signed long-term memory)
MEMORIA_URL=https://www.memoriaagent.site
MEMORIA_API_KEY=

# Rushr safety settings — keep dry-run ON
RUSHR_DRY_RUN=1
RUSHR_MAX_TRADE_USD=10
RUSHR_DAILY_USD=50

# The Rushr agent wallet lives OUTSIDE this project, at:
#   %USERPROFILE%\.rushr\agent-wallet.json
# It holds a private key. Never copy it into this repo, never open it, never share it.
